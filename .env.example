# Why Is This Pumping? — copy to .env.local

# Optional. Leave blank and the app is open; set it to require a passphrase.
ACCESS_CODE=

# Signs the access cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Your Base44 Superagent. Leave blank to run on realistic mock data.
# Both values come from the Superagent's Developer panel. Use the Base URL
# exactly as shown, e.g. https://<your-app>.base44.com/api/agents/<agentId>
BASE44_SUPERAGENT_BASE_URL=
BASE44_SUPERAGENT_API_KEY=

# Early Runner Radar. The key must only exist on the server.
BASE44_AGENT_API_BASE=https://app.base44.com/api/agents/6a9c66e330a23e2f907a2242
BASE44_AGENT_ID=6a9c66e330a23e2f907a2242
BASE44_AGENT_API_KEY=
# Optional fallback when this Base44 deployment uses one fixed conversation.
BASE44_AGENT_CONVERSATION_ID=
RADAR_TIMEOUT_MS=240000
RADAR_FORCE_FIXTURE=false

# Optional. Enables the message.completed webhook, which removes the few
# seconds between the agent finishing and the next poll noticing. Set this to
# the signing secret from the Superagent Developer panel, and point the webhook
# at https://<your-domain>/api/webhooks/base44
BASE44_WEBHOOK_SECRET=

# Set false to instantly stop all analyses without a code change.
ANALYSIS_ENABLED=true
